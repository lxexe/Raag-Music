root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[LICENSES/**]
trim_trailing_whitespace = false

[app/src/main/assets/licenses/**]
trim_trailing_whitespace = false

[app/src/main/assets/fonts/*-OFL.txt]
trim_trailing_whitespace = false
